  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ad5815a14f6884d4bac95b73796cbc8c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 669420617}
  nameTextComponent: {fileID: 924835173}
  lines:
  - 'Ma lends a silent sigh followed by a mutter



'
  - 'Ma lends a silent sigh followed by a mutter



'
  - "\u201CIm sorry about my down mood, my bouquet of Lilies died over night, just
    how peculiar\u201D"
  - "\u201CIm sorry about my down mood, my bouquet of Lilies died over night, just
    how peculiar\u201D"
  - "\u201CIt must be Evil Eyes, I need to visit Crystal soon\u201D\r\n"
  - "\u201CIt must be Evil Eyes, I need to visit Crystal soon\u201D\r\n"
  - "\u201CIt must be Evil Eyes, I need to visit Crystal soon\u201D\r\n"
  - "\u201CCrystal??\u201D\r\n"
  - "\u201CCrystal??\u201D\r\n"
  - "\u201CThis tarot lady I ran into while out on groceries, Mercury Retrograde
    is upon us you know\u201D\r\n"
  - "\u201CThis tarot lady I ran into while out on groceries, Mercury Retrograde
    is upon us you know\u201D\r\n"
  - 'I chuckle softly

'
  - 'I chuckle softly

'
  - "\u201CAnd you believe in all of that junk?\u201D\r\n"
  - "\u201CAnd you believe in all of that junk?\u201D\r\n"
  - "Hypocrisy was across my tongue. \r\n\r\n"
  - "Hypocrisy was across my tongue. \r\n\r\n"
  - " \u201CMY BOUQUET DIED OVER NIGHT\u201D\r\n"
  - " \u201CMY BOUQUET DIED OVER NIGHT\u201D\r\n"
  - 'Echoes through my ears '
  - 'Echoes through my ears '
  - 'To think this White Lily acquired from my dream; is now of flesh

'
  - 'To think this White Lily acquired from my dream; is now of flesh

'
  - 'Just how much more does this DreamScape crossover into what I believe to be
    my Reality.

'
  - 'Just how much more does this DreamScape crossover into what I believe to be
    my Reality.

'
