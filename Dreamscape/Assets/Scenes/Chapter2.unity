  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 584406000}
  nameTextComponent: {fileID: 1336434369}
  lines:
  - "I snap out of my daydream and see her standing in front of me \r\n"
  - "I snap out of my daydream and see her standing in front of me \r\n"
  - "A frown plastered across her face, She was wearing a rather mopy expression
    \r\n"
  - "A frown plastered across her face, She was wearing a rather mopy expression
    \r\n"
  - 'Thats when I noticed it-

'
  - 'Thats when I noticed it-

'
  - "\u201CVivi your-\u201D\r\n"
  - "\u201CVivi your-\u201D\r\n"
  - "\u201CYes yes Onyx dont even begin to describe the monstrous state I am in as
    of current.\u201D"
  - "\u201CYes yes Onyx dont even begin to describe the monstrous state I am in as
    of current.\u201D"
  - "Vivienne always enjoyed being dramatic it\u2019s one of my favourite things
    about her."
  - "Vivienne always enjoyed being dramatic it\u2019s one of my favourite things
    about her."
  - "\u201CYour lips-\u201D"
  - "\u201CYour lips-\u201D"
  - "\u201CGone! My Dior Rogue Velvet Red Lipstick gone!! I checked my purse and
    it vanished! Cant\u2019 even get another since its out of stock\u201D.\r\n"
  - "\u201CGone! My Dior Rogue Velvet Red Lipstick gone!! I checked my purse and
    it vanished! Cant\u2019 even get another since its out of stock\u201D.\r\n"
  - 'My spirits sank.

'
  - 'My spirits sank.

'
  - "Red Lipstick\u2026like the one I found in the bathroom\u2026\r\n"
  - "Red Lipstick\u2026like the one I found in the bathroom\u2026\r\n"
