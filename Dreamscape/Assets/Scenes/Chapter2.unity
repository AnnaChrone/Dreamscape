  m_Script: {fileID: 11500000, guid: ad5815a14f6884d4bac95b73796cbc8c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 1434410033}
  nameTextComponent: {fileID: 1690870276}
  lines:
  - 'I place the flower in the vase, the White Lily to complete my routine. '
  - 'I place the flower in the vase, the White Lily to complete my routine. '
  - 'Ma gasps loudly then lends a smile

'
  - 'Ma gasps loudly then lends a smile

'
  - "\u201CI had wandered why my bouquet died over night, but seems you stole one
    away from the decaying mass\u201D\r\n\r\n"
  - "\u201CI had wandered why my bouquet died over night, but seems you stole one
    away from the decaying mass\u201D\r\n\r\n"
  - "\u201CThank you my dear Nyxie\u201D\r\n"
  - "\u201CThank you my dear Nyxie\u201D\r\n"
  - "\u201CThank you my dear Nyxie\u201D\r\n"
  - 'I return her smile and release an undeserving sigh of relief

'
  - 'I return her smile and release an undeserving sigh of relief

'
  - "\u201CMY BOUQUET DIED OVER NIGHT\u201D\r\n"
  - "\u201CMY BOUQUET DIED OVER NIGHT\u201D\r\n"
  - "\u201CMY BOUQUET DIED OVER NIGHT\u201D\r\n"
  - 'Echoes through my ears '
  - 'Echoes through my ears '
  - 'To think this White Lily acquired from my dream; is now of flesh

'
  - 'To think this White Lily acquired from my dream; is now of flesh

'
  - 'Just how much more does this DreamScape crossover into what I believe to be
    my Reality.

'
  - 'Just how much more does this DreamScape crossover into what I believe to be
    my Reality.

'
