  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ad5815a14f6884d4bac95b73796cbc8c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 1780553407}
  nameTextComponent: {fileID: 166521893}
  lines:
  - 'I walk over to his desk as he shuffles through the papers, as if distracting
    himself from watching me walk up.

    

'
  - 'I walk over to his desk as he shuffles through the papers, as if distracting
    himself from watching me walk up.

    

'
  - "There\u2019s already a type of tension between us as i reach his desk.\r\n"
  - "There\u2019s already a type of tension between us as i reach his desk.\r\n"
  - "\u201CExcuse me Sir\u201D\r\n"
  - "\u201CExcuse me Sir\u201D\r\n"
  - 'I reach into my bag and just knew the book would spawn in , I take it out and
    pass it to him.

'
  - 'I reach into my bag and just knew the book would spawn in , I take it out and
    pass it to him.

'
  - "He raises an eyebrow and chuckles taking the book and scanning it \r\n"
  - "He raises an eyebrow and chuckles taking the book and scanning it \r\n"
  - "\u201CSeems you also have a copy, good taste Nyx\u201D\r\n"
  - "\u201CSeems you also have a copy, good taste Nyx\u201D\r\n"
  - "His direct addressal of me makes me uneasy as if he should\u2019nt be allowed
    to say my name.\r\n\r\n"
  - "His direct addressal of me makes me uneasy as if he should\u2019nt be allowed
    to say my name.\r\n\r\n"
  - "\u201CA copy?\u201D"
  - "\u201CA copy?\u201D"
  - "\u201CYes\u201D\r\n"
  - "\u201CYes\u201D\r\n"
  - "He reaches over and grabs his copy and holds it up. He grabs his copy. As in-it\u2019s
    real.\r\n"
  - "He reaches over and grabs his copy and holds it up. He grabs his copy. As in-it\u2019s
    real.\r\n"
  - "\u201CI urge you to read it back to front for the course, although mine is better
    condition than yours\u201D"
  - "\u201CI urge you to read it back to front for the course, although mine is better
    condition than yours\u201D"
  - "I take it as him teasing \r\n"
  - "I take it as him teasing \r\n"
  - 'I feel myself slowly losing grip with my reality

'
  - 'I feel myself slowly losing grip with my reality

'
  - "Everyone else\u2019s items have been lost , so why isnt his??\r\n"
  - "Everyone else\u2019s items have been lost , so why isnt his??\r\n"
