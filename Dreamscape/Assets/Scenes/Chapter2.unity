  nameTextComponent: {fileID: 1547814952}
  lines:
  - "I pack up my things , Vivienne does the same as we walk down the stairs approaching
    the prof\u2019s desk as he shuffles through the quiz sheets. \r\n\r\n"
  - "I pack up my things , Vivienne does the same as we walk down the stairs approaching
    the prof\u2019s desk as he shuffles through the quiz sheets. \r\n\r\n"
  - "He reaches over and grabs his BLUE BOOK and holds it up. He grabs his copy.
    As in-it\u2019s real.\r\n"
  - "He reaches over and grabs his BLUE BOOK and holds it up. He grabs his copy.
    As in-it\u2019s real.\r\n"
