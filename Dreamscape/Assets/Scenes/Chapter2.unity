  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 2116842675}
  nameTextComponent: {fileID: 143298331}
  lines:
  - "\u201CWhere did you get yours\u201D\r\n"
  - "\u201CWhere did you get yours\u201D\r\n"
  - 'He raisies an eyebrow as if caught off guard.

'
  - 'He raisies an eyebrow as if caught off guard.

'
  - "\u201CAn old friend of mine\u201D\r\n"
  - "\u201CAn old friend of mine\u201D\r\n"
  - He answers
  - He answers
  - "\u201CFriend or professor?\u201D\r\n"
  - "\u201CFriend or professor?\u201D\r\n"
  - 'I ask and watch as his jaw clenches

'
  - 'I ask and watch as his jaw clenches

'
  - "\u201CWatch it Nyx\u201D\r\n"
  - "\u201CWatch it Nyx\u201D\r\n"
  - "\u201CWatch what\u201D\r\n"
  - "\u201CWatch what\u201D\r\n"
  - "\u201CYour tone. I am your professor after all\u201D\r\n"
  - "\u201CYour tone. I am your professor after all\u201D\r\n"
  - 'He slings his satchel over his shoulder

'
  - 'He slings his satchel over his shoulder

'
  - "\u201CNow next time you visit my desk, have actual questions on the course work\u201D\r\n"
  - "\u201CNow next time you visit my desk, have actual questions on the course work\u201D\r\n"
  - 'He barely scrapes past me as i smirk.

'
  - 'He barely scrapes past me as i smirk.

'
  - 'His reaction is quite telling

'
  - 'His reaction is quite telling

'
  Actors:
