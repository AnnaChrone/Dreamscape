  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 235216678}
  nameTextComponent: {fileID: 2119172117}
  lines:
  - "\u201CApologies to all for arriving late , I managed to sleep through my alarms,
    now pack everything away , it\u2019s Pop Quiz time\u201D\r\n"
  - "\u201CApologies to all for arriving late , I managed to sleep through my alarms,
    now pack everything away , it\u2019s Pop Quiz time\u201D\r\n"
  - "Annoyed grunts fill the room and everyone shuffles their possessions away. \r\n"
  - "Annoyed grunts fill the room and everyone shuffles their possessions away. \r\n"
  - "He begins walking up the rows , swiping out and distributing pop quiz sheets
    as he was still quite traditional. \r\n"
  - "He begins walking up the rows , swiping out and distributing pop quiz sheets
    as he was still quite traditional. \r\n"
  - 'My eyes wander to his desk out of habit to where he usually stood

'
  - 'My eyes wander to his desk out of habit to where he usually stood

'
  - 'My heart drops, as i see the bright blue book which was actually a copy of Alice
    in Wonderland '
  - 'My heart drops, as i see the bright blue book which was actually a copy of Alice
    in Wonderland '
  - 'He eventually reaches my row and as i reach out to grab the sheet , i noticed
    his rolled up sleeves and as i grab the paper it smudges red.

'
