--- !u!114 &1806509390
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1806509386}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ad5815a14f6884d4bac95b73796cbc8c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 1270248226}
  nameTextComponent: {fileID: 1028347252}
  lines:
  - "\u201CNyxie love are you alright?\u201D\r\n"
  - "\u201CNyxie love are you alright?\u201D\r\n"
  - 'I turn back to see my mom with a concerned look

'
  - 'I turn back to see my mom with a concerned look

'
  - 'I grab her shoulders out of fear

'
  - 'I grab her shoulders out of fear

'
  - "\u201CWhere\u2019s Baba??\u201D\r\n"
  - "\u201CWhere\u2019s Baba??\u201D\r\n"
  - "Ma\u2019s eyes widen in shock \r\n"
  - "Ma\u2019s eyes widen in shock \r\n"
  - "\u201CWhy you havent called him that in years Nyxie\u201D\r\n"
  - "\u201CWhy you havent called him that in years Nyxie\u201D\r\n"
  - "\u201CBut don\u2019t fret, he\u2019s just still asleep in the bedroom\u201D\r\n"
  - "My breath hitches and I hug my mom tightly \r\n"
  - "My breath hitches and I hug my mom tightly \r\n"
  - "\u201C\u092D\u0917\u0935\u093E\u0928 \u0915\u093E \u0936\u0941\u0915\u094D\u0930
    \u0939\u0948\u201D\r\n"
  - "\u201C\u092D\u0917\u0935\u093E\u0928 \u0915\u093E \u0936\u0941\u0915\u094D\u0930
    \u0939\u0948\u201D\r\n"
  - 'Ma bursts out laughing to my hindi

'
  - 'Ma bursts out laughing to my hindi

'
  - "\u201CNow, now why are we thanking God\u201D\r\n"
  - "\u201CNow, now why are we thanking God\u201D\r\n"
  - "\u201CI was worried about Baba\u2026I had a bad dream\u201D"
  - "\u201CI was worried about Baba\u2026I had a bad dream\u201D"
  - "\u201COh- a nightmare my poor Nyxie, but dont fret\u201D\r\n"
  - "\u201COh- a nightmare my poor Nyxie, but dont fret\u201D\r\n"
  - "\u201CBaba is just tired from this morning\u201D\r\n"
  - "\u201CBaba is just tired from this morning\u201D\r\n"
  - "\u201CThis morning?\u201D\r\n"
  - "\u201CThis morning?\u201D\r\n"
  - "\u201CYes, early morning, he woke up screaming in pain\u2026\u201D\r\n"
  - "\u201CYes, early morning, he woke up screaming in pain\u2026\u201D\r\n"
  - "\u201CHe kept holding his Nape to check if it\u2019s sturdy as if his head is
    screwed on right\u201D\r\n"
  - "\u201CHe kept holding his Nape to check if it\u2019s sturdy as if his head is
    screwed on right\u201D\r\n"
  - 'My heart sinks and that anxiety comes knocking full force

'
  - 'My heart sinks and that anxiety comes knocking full force

'
  - 'I''m in utter fear and disbelief as I can''t even help but mutter out.

'
  - 'I''m in utter fear and disbelief as I can''t even help but mutter out.

'
  - "\u201CH-His N-Nape?\u201D\r\n"
  - "\u201CH-His N-Nape?\u201D\r\n"
