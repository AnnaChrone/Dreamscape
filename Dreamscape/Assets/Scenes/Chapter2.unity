  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 796284477}
  nameTextComponent: {fileID: 66658896}
  lines:
  - 'I spring to life , wide awake , as I cling to my sheets

'
  - 'I spring to life , wide awake , as I cling to my sheets

'
  - 'My breath is heavy



    In pants

'
  - 'My breath is heavy



    In pants

'
  - 'I pinch my flesh to see if I am truly awake

'
  - 'I pinch my flesh to see if I am truly awake

'
  - "\u201CWhat The fu-\u201D\r\n"
  - "\u201CWhat The fu-\u201D\r\n"
  - "Before I can finish \r\n\r\nI feel my fist brush against my pillow \r\n"
  - "Before I can finish \r\n\r\nI feel my fist brush against my pillow \r\n"
  - 'Something is tucked underneath

'
  - 'Something is tucked underneath

'
  - 'I hoist my pillow in the air , revealing the hidden object

'
  - 'I hoist my pillow in the air , revealing the hidden object

'
  - "\u201CNo..\u201D\r\n"
  - "\u201CNo..\u201D\r\n"
  - 'I hold the item in my hands

'
  - 'I hold the item in my hands

'
  - 'My eyes widen and throat shallow for breath

'
  - 'My eyes widen and throat shallow for breath

'
  - "\u201CT-This can\u2019t be- no- it\u2019s impossible\u201D\r\n"
  - "\u201CT-This can\u2019t be- no- it\u2019s impossible\u201D\r\n"
  - "\u201CI must be dreaming still\u201D\r\n"
  - "\u201CI must be dreaming still\u201D\r\n"
  - 'I rationalise with myself as I re-tuck myself under the covers and close my
    eyes

'
  - 'I rationalise with myself as I re-tuck myself under the covers and close my
    eyes

'
  - 'But my lids kept drawing back open like broken blinds on a window

'
  - 'But my lids kept drawing back open like broken blinds on a window

'
  - 'Worst of all

'
  - 'Worst of all

'
  - 'My palms were still warm of the object encased within.

'
  - 'My palms were still warm of the object encased within.

'
  - "Tears spring to my eyes and I felt anxiety flood me \r\n"
  - "Tears spring to my eyes and I felt anxiety flood me \r\n"
  - "\u201CT-this cant be happening! It cant be\u201D\r\n"
  - "\u201CT-this cant be happening! It cant be\u201D\r\n"
  - 'BEEP BEEP BEEP BEEP

'
  - 'BEEP BEEP BEEP BEEP

'
  - " \u201CI really can\u2019t do this right now\u201D\r\n"
  - " \u201CI really can\u2019t do this right now\u201D\r\n"
