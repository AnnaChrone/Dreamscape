  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 792337767}
  nameTextComponent: {fileID: 179232177}
  lines:
  - 'I reach into my pocket and fish out the lipstick, I dont recall even bringing
    it with from under my pillow

'
  - 'I reach into my pocket and fish out the lipstick, I dont recall even bringing
    it with from under my pillow

'
  - "Vivienne's face lights up as I hand it to her \r\n"
  - "Vivienne's face lights up as I hand it to her \r\n"
  - "\u201CIt rolled off your desk yesterday and I\u2019ve been meaning to give it
    back\u201D\r\n"
  - "\u201CIt rolled off your desk yesterday and I\u2019ve been meaning to give it
    back\u201D\r\n"
  - "I lie through my teeth \r\n"
  - "I lie through my teeth \r\n"
  - 'I had never been known to lie mainly because I never wanted to resort to dishonesty

'
  - 'I had never been known to lie mainly because I never wanted to resort to dishonesty

'
  - "I feel a bit of guilt as she takes it \r\n"
  - "I feel a bit of guilt as she takes it \r\n"
  - 'But what could I have done ? Tell her the truth? Being risked to be seen as-

'
  - 'But what could I have done ? Tell her the truth? Being risked to be seen as-

'
  - "\u201CCrazy, I dont remember even taking it out of my bag, thank you love\u201D\r\n"
  - "\u201CCrazy, I dont remember even taking it out of my bag, thank you love\u201D\r\n"
  - "She says immediately fishing out her compact and re-applying it. \r\n"
  - "She says immediately fishing out her compact and re-applying it. \r\n"
