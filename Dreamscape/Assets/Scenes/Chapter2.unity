  m_Script: {fileID: 11500000, guid: ad5815a14f6884d4bac95b73796cbc8c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 716879978}
  nameTextComponent: {fileID: 1208735237}
  lines:
  - 'I walk out of class and notice Vivi gone, assuming she must have been rushing
    to her next class.

'
  - 'I walk out of class and notice Vivi gone, assuming she must have been rushing
    to her next class.

'
  - "\u201CThat quiz was pretty tough huh\u201D\r\n"
  - "\u201CThat quiz was pretty tough huh\u201D\r\n"
  - 'I hear an unfamiliar voice say to me as I turn my head to see.

    

'
  - 'I hear an unfamiliar voice say to me as I turn my head to see.

    

'
  - "A girl with a short bob of hair much shorter than me stands, clutching her books
    to her chest with a friendly smile. \r\n"
  - "A girl with a short bob of hair much shorter than me stands, clutching her books
    to her chest with a friendly smile. \r\n"
  - "\u201CYeah I guess so\u201D\r\n"
  - "\u201CYeah I guess so\u201D\r\n"
  - "\u201CWe saw you flirting with the professor\u201D\r\n"
  - "\u201CWe saw you flirting with the professor\u201D\r\n"
  - 'Another voice chimes in, turning my head to the side I see another figure running
    up to intrude on our conversation. '
  - 'Another voice chimes in, turning my head to the side I see another figure running
    up to intrude on our conversation. '
  - "\u201CShut up Spike, she doesn\u2019t seem like that kind of girl\u201D\r\n"
  - "\u201CShut up Spike, she doesn\u2019t seem like that kind of girl\u201D\r\n"
  - "\u201CToo bad she ain\u2019t \u201D\r\n"
  - "\u201CToo bad she ain\u2019t \u201D\r\n"
  - 'The boy flashes me a smile as his eyes scan my figure up and down.

'
  - 'The boy flashes me a smile as his eyes scan my figure up and down.

'
  - "\u201CWhat\u2019s your name pretty\u201D\r\n"
  - "\u201CWhat\u2019s your name pretty\u201D\r\n"
  - I grunt and stop myself from rolling my eyes but answer out of courtesy.
  - I grunt and stop myself from rolling my eyes but answer out of courtesy.
  - "\u201CNyx. and you two are?\u201D\r\n"
  - "\u201CNyx. and you two are?\u201D\r\n"
  - "\u201CSpike and Claire, I'm sure you can tell which is which\u201D\r\n"
  - "\u201CSpike and Claire, I'm sure you can tell which is which\u201D\r\n"
  - 'Claire?? As in the gossiping Claire that I overheard from that conversation.

'
  - 'Claire?? As in the gossiping Claire that I overheard from that conversation.

'
  - 'My eyes widen and my mouth falls open.

'
  - 'My eyes widen and my mouth falls open.

'
  - "\u201CJasper, don\u2019t forget, my office, 5 minutes\u201D\r\n"
  - "\u201CJasper, don\u2019t forget, my office, 5 minutes\u201D\r\n"
  - 'The professor interrupts  mid conversation, Jasper lets out an annoyed sigh.

'
  - 'The professor interrupts  mid conversation, Jasper lets out an annoyed sigh.

'
  - "\u201CAye, aye Captain\u201D\r\n"
  - "\u201CAye, aye Captain\u201D\r\n"
  - 'Both people look to me simultaneously.

'
  - 'Both people look to me simultaneously.

'
  - "\u201CHow about you get to know us better?\u201D\r\n"
  - "\u201CHow about you get to know us better?\u201D\r\n"
  - "If I go with Claire, I\u2019d be able to get some direct information on what
    she may know regarding the professor.\r\n"
  - "If I go with Claire, I\u2019d be able to get some direct information on what
    she may know regarding the professor.\r\n"
  - "If I go with Spike, I\u2019\u2019ll get an exclusive look into his office."
  - "If I go with Spike, I\u2019\u2019ll get an exclusive look into his office."
