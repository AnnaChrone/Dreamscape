  nameTextComponent: {fileID: 1748150178}
  lines:
  - 'I reach the foot of my stairs, 9AM on the clock, class starts at 10-

'
  - 'I reach the foot of my stairs, 9AM on the clock, class starts at 10-

'
  - "\"NUMBER 5 HEADING ON STRONG , HOPEFULLY SHE DOESNT CRASH DOWN\u201D"
  - "\"NUMBER 5 HEADING ON STRONG , HOPEFULLY SHE DOESNT CRASH DOWN\u201D"
  - 'My thoughts interrupted by the horse race announcers

'
  - 'My thoughts interrupted by the horse race announcers

'
  - "Last night\u2019s nightmare flashes through my mind\r\n"
  - "Last night\u2019s nightmare flashes through my mind\r\n"
  - "The image of my father\u2019s head turned scorched into my memory\r\n"
  - "The image of my father\u2019s head turned scorched into my memory\r\n"
  - "If the Item crossed over from DreamScape into Reality\u2026does that mean\u2026\r\n\r\n"
  - "If the Item crossed over from DreamScape into Reality\u2026does that mean\u2026\r\n\r\n"
  - 'No! I-It cant be!

'
  - 'No! I-It cant be!

'
  - 'I spin the corner in hopes of seeing my father in his usual spot.

'
  - 'I spin the corner in hopes of seeing my father in his usual spot.

'
  - "\u201CAaanndd Number 5 loses to 4 , better luck next time\u201D\r\n"
  - "\u201CAaanndd Number 5 loses to 4 , better luck next time\u201D\r\n"
  - 'The couch rest , empty with a clear line of vision of the TV

'
  - 'The couch rest , empty with a clear line of vision of the TV

'
  - 'Tears rolled down my cheeks

'
  - 'Tears rolled down my cheeks

'
  - "\u201CD-Dad??\u201D\r\n"
  - "\u201CD-Dad??\u201D\r\n"
  - "\u201CBaba\u201D\r\n"
  - "\u201CBaba\u201D\r\n"
